@model H_st_2026_Gruppe_1.Models.ResourceDashboard

@{
    ViewData["Title"] = "Ressurser";
    string StatusClass(string? statusValue) => statusValue switch
    {
        "accepted" or "assigned" => "status-assigned",
        "proposed" or "under_review" => "status-under-review",
        "declined" or "rejected" => "status-rejected",
        "completed" or "resolved" => "status-completed",
        "available" => "status-available",
        "unavailable" or "withdrawn" => "status-unavailable",
        "new" => "status-new",
        _ => ""
    };
    string StatusIcon(string? statusValue) => statusValue switch
    {
        "accepted" or "assigned" => "bi-check-circle-fill",
        "proposed" or "under_review" => "bi-hourglass-split",
        "declined" or "rejected" => "bi-x-circle-fill",
        "completed" or "resolved" => "bi-check2-all",
        "available" => "bi-box-seam",
        "unavailable" or "withdrawn" => "bi-box-seam",
        "new" => "bi-circle",
        _ => "bi-info-circle"
    };
    var categories = ViewBag.Categories as List<H_st_2026_Gruppe_1.Models.Category> ?? new();
    var canEditResources = User.IsInRole("Administrator") || User.IsInRole("CivilianProvider");
    var statuses = Model.Resources
        .Select(resource => resource.Status)
        .Where(status => !string.IsNullOrWhiteSpace(status))
        .Distinct()
        .OrderBy(status => status)
        .ToList();
}

<section class="subpage">
    <div class="subpage-header">
        <div>
            <h1>Ressurser</h1>
            <p class="page-intro">Oversikt over ressurser.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="resource-feedback" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }

    <form id="resourceFilterForm" method="get" asp-controller="Resources" asp-action="Index" class="dashboard-filter-bar">
        <div class="dashboard-filter-field">
            <label for="resourceSearch" class="form-label text-muted small fw-bold">Søk</label>
            <input type="search" name="search" id="resourceSearch" class="form-control"
                   value="@Model.Search" placeholder="Søk etter ressursnavn" />
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceStatusFilter" class="form-label text-muted small fw-bold">Filtrer på status</label>
            <select name="status" id="resourceStatusFilter" class="form-select">
                <option value="">Alle</option>
                @foreach (var status in statuses)
                {
                    <option value="@status" selected="@(Model.Status == status)">@StatusLabelHelper.DisplayName(status)</option>
                }
            </select>
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceTypeFilter" class="form-label text-muted small fw-bold">Filtrer på type</label>
            <select name="resourceType" id="resourceTypeFilter" class="form-select">
                <option value="">Alle</option>
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId" selected="@(Model.ResourceType == category.CategoryId)">
                        @CategoryLabelHelper.DisplayName(category.CategoryName)
                    </option>
                }
            </select>
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceStartDate" class="form-label text-muted small fw-bold">Dato fra</label>
            <input type="date" name="startDate" id="resourceStartDate" class="form-control"
                   value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceEndDate" class="form-label text-muted small fw-bold">Dato til</label>
            <input type="date" name="endDate" id="resourceEndDate" class="form-control"
                   value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="dashboard-filter-field dashboard-distance-field">
            <label for="resourceRadiusFilter" class="form-label text-muted small fw-bold">Avstand</label>
            <input id="resourceRadiusFilter" type="range" class="form-range" min="0" max="100" step="5" value="0" />
            <div class="dashboard-radius-value" id="resourceRadiusValue">Alle avstander</div>
        </div>

        <div class="dashboard-filter-actions">
            <button type="submit" class="btn btn-primary">Filtrer</button>
            <a asp-controller="Resources" asp-action="Index" class="btn btn-outline-secondary">Nullstill</a>
        </div>
    </form>

    <p id="resource-location-error" class="dashboard-location-error" role="alert" aria-live="polite" hidden>
        Tilgang til posisjon kreves for å bruke avstandsfilteret.
    </p>

    @if (!Model.Resources.Any())
    {
        <p class="placeholder-copy">Ingen ressurser er registrert akkurat nå.</p>
    }
    else
    {
        <div class="match-results-heading">
            <div>
                <p class="page-eyebrow">RESULTATER</p>
                <h2>Registrerte ressurser</h2>
            </div>
        </div>
        <div class="resource-list">
            @foreach (var resource in Model.Resources)
            {
                var resourceMatches = Model.MatchStatuses
                    .Where(match => match.ResourceId == resource.Id)
                    .ToList();
                var isWithdrawn = resource.Status == "withdrawn";

                <article class="dashboard-card resource-card @(isWithdrawn ? "resource-card--withdrawn" : "")"
                         data-latitude="@resource.Latitude"
                         data-longitude="@resource.Longitude">
                    <div class="dashboard-card-header">
                        <h2>@resource.Name</h2>
                        <span class="status-label @StatusClass(resource.Status)">
                            <i class="bi @(isWithdrawn ? "bi-archive-fill" : StatusIcon(resource.Status))" aria-hidden="true"></i>
                            @StatusLabelHelper.DisplayName(resource.Status)
                        </span>
                    </div>

                    <p class="dashboard-card-description">@resource.Description</p>

                    <dl class="dashboard-details resource-details">
                        <div>
                            <dt><i class="bi bi-tag" aria-hidden="true"></i> Type</dt>
                            <dd>@(resource.Category is null ? "Ikke oppgitt" : CategoryLabelHelper.DisplayName(resource.Category.CategoryName))</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-person" aria-hidden="true"></i> Kontakt</dt>
                            <dd>@resource.Email<br />@resource.PhoneNumber</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-geo-alt" aria-hidden="true"></i> Sted (breddegrad/lengdegrad)</dt>
                            <dd>
                                @if (resource.Latitude.HasValue && resource.Longitude.HasValue)
                                {
                                    @($"{resource.Latitude:F5}, {resource.Longitude:F5}")
                                }
                                else
                                {
                                    @:Ingen posisjon valgt
                                }
                            </dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-clock-history" aria-hidden="true"></i> Registrert</dt>
                            <dd>@resource.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-calendar-event" aria-hidden="true"></i> Gyldig fra</dt>
                            <dd>@resource.AvailableFrom.ToString("dd.MM.yyyy")</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-calendar-x" aria-hidden="true"></i> Utløpsdato</dt>
                            <dd>@(resource.ExpirationDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
                        </div>
                    </dl>

                    @if (resourceMatches.Any())
                    {
                        <div class="resource-assigned-matches">
                            @foreach (var match in resourceMatches)
                            {
                                <div class="resource-assigned-match">
                                    <span>
                                        <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                        Tildelt til behov: <strong>@match.NeedTitle</strong>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(match.Comment))
                                    {
                                        <span class="resource-match-comment">@match.Comment</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="dashboard-card-footer">
                        <div class="dashboard-card-actions">
                            @if (canEditResources)
                            {
                                <a asp-controller="Resources" asp-action="Index" asp-route-id="@resource.Id"
                                   class="btn btn-sm btn-primary">Rediger</a>
                                @if (!isWithdrawn)
                                {
                                    <form asp-controller="Home" asp-action="DeleteResource"
                                          asp-route-id="@resource.Id" method="post"
                                          data-confirm="Ressursen trekkes tilbake og blir ikke lenger tilgjengelig. Matchhistorikken beholdes.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Trekk tilbake</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="resource-withdrawn-note">
                                        <i class="bi bi-archive" aria-hidden="true"></i>
                                        Trukket tilbake
                                    </span>
                                }
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (ViewBag.EditResource is H_st_2026_Gruppe_1.Models.ResourceEntry editResource)
{
    <div class="modal fade registration-modal" id="registrationModal" tabindex="-1"
         aria-labelledby="registrationModalTitle" aria-hidden="true" data-bs-backdrop="static"
         data-registration-modal data-open-registration-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="registrationModalTitle">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                        <span>Rediger ressurs</span>
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Lukk registreringsskjema"></button>
                </div>
                <div class="modal-body" data-registration-modal-body>
                    <partial name="~/Views/Home/_ResourceRegistrationForm.cshtml" model="editResource" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@Context.Items["CspNonce"]">
        window.resqRegistration.initializeDateTimeFields('resourceForm', [
            { dateId: 'availableFromDate', timeId: 'availableFromTime', valueId: 'availableFromValue' },
            { dateId: 'expiryDate', timeId: 'expirationTime', valueId: 'expirationValue',
              rangeErrorId: 'resourceDateRangeError' }
        ]);
        window.resqRegistration.bindCurrentLocationButton('useCurrentLocation', {
            onPosition: (latitude, longitude) => {
                document.getElementById('latInput').value = latitude;
                document.getElementById('lngInput').value = longitude;
                document.getElementById('posText').textContent =
                    'Valgt posisjon: bredde: ' + latitude.toFixed(5) + ', lengde: ' + longitude.toFixed(5);
            }
        });

        const modalElement = document.getElementById('registrationModal');
        if (modalElement?.dataset.openRegistrationModal === 'true') {
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }

        window.resqDateRange.bindFilter(
            'resourceFilterForm',
            'resourceStartDate',
            'resourceEndDate');
        window.resqRadius.initializeDistanceFilter({
            sliderId: 'resourceRadiusFilter',
            valueId: 'resourceRadiusValue',
            errorId: 'resource-location-error',
            cardSelector: '.resource-card'
        });
    </script>
}
