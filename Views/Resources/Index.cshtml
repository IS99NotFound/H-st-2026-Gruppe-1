@model H_st_2026_Gruppe_1.Models.ResourceDashboard

@{
    ViewData["Title"] = "Resources";
    ViewData["WideContent"] = true;
}

<section class="subpage resources-page">
    <div class="subpage-header">
        <h1>Resources</h1>
    </div>

@if (!Model.Resources.Any())
{
    <p class="placeholder-copy">No resources are registered right now</p>
}
else
{
    <div class="table-wrapper resources-table-wrapper">
    <table class="table table-dark table-striped resources-table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Telephone</th>
            <th>Type</th>
            <th>Description</th>
            <th>Effective date</th>
            <th>Expiry date</th>
            <th>Lat/Long</th>
            <th>Registered</th>
            <th> Status </th>
            <th> Actions </th>
            
        </tr>
        </thead>
        
        <tbody>
            @foreach (var r in Model.Resources)
            {
                var normalizedStatus = (r.Status ?? "").Trim().ToLowerInvariant();
                var statusClass = normalizedStatus switch
                {
                    "ny" or "new" => "status-new",
                    "available" => "status-available",
                    "assigned" => "status-assigned",
                    "under_review" => "status-under-review",
                    "rejected" => "status-rejected",
                    "unavailable" => "status-unavailable",
                    "withdrawn" => "status-withdrawn",
                    _ => ""
                };
                var statusText = normalizedStatus switch
                {
                    "ny" or "new" => "New",
                    "under_review" => "Under review",
                    _ => r.Status
                };

                <tr>
                    <td>@r.Name</td>
                    <td>@r.Phone</td>
                    <td>@r.Category?.CategoryName</td>
                    <td>@r.Description</td>
                    <td>@r.AvailableFrom.ToString("dd.MM.yyyy")</td>
                    <td>@r.ExpirationDate?.ToString("dd.MM.yyyy")</td>
                    
                    <td>
                        @if (r.Latitude != null && r.Longitude != null)
                        {
                            @($"{r.Latitude:F5}, {r.Longitude:F5}")
                        }
                        else
                        {
                            <span>No position selected</span>
                        }
                    </td>
                    <td>@r.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span class="status-label @statusClass">@statusText</span>
                    </td>
                    <td>
                        <form class="resource-actions" asp-controller="Home" asp-action="DeleteResource" asp-route-id="@r.Id" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this resource?');">
                            <a asp-controller="Home" asp-action="Index" asp-route-id="@r.Id" class="btn btn-sm btn-primary">
                                Edit
                            </a>
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                 
                </tr>
            }
        </tbody>
    </table>
    </div>
}
</section>