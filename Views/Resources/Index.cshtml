@model H_st_2026_Gruppe_1.Models.ResourceDashboard

@{
    ViewData["Title"] = "Resources";
    var categories = ViewBag.Categories as List<H_st_2026_Gruppe_1.Models.Category> ?? new();
    var statuses = Model.Resources
        .Select(resource => resource.Status)
        .Where(status => !string.IsNullOrWhiteSpace(status))
        .Distinct()
        .OrderBy(status => status)
        .ToList();
}

<section class="subpage">
    <div class="subpage-header">
        <h1>Resources</h1>
    </div>

    <form id="resourceFilterForm" method="get" asp-controller="Resources" asp-action="Index" class="dashboard-filter-bar">
        <div class="dashboard-filter-field">
            <label for="resourceSearch" class="form-label text-muted small fw-bold">Search</label>
            <input type="search" name="search" id="resourceSearch" class="form-control"
                   value="@Model.Search" placeholder="Search resource name" />
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceStatusFilter" class="form-label text-muted small fw-bold">Filter by status</label>
            <select name="status" id="resourceStatusFilter" class="form-select">
                <option value="">All</option>
                @foreach (var status in statuses)
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceTypeFilter" class="form-label text-muted small fw-bold">Filter by type</label>
            <select name="resourceType" id="resourceTypeFilter" class="form-select">
                <option value="">All</option>
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId" selected="@(Model.ResourceType == category.CategoryId)">
                        @category.CategoryName
                    </option>
                }
            </select>
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceStartDate" class="form-label text-muted small fw-bold">Date from</label>
            <input type="date" name="startDate" id="resourceStartDate" class="form-control"
                   value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="dashboard-filter-field">
            <label for="resourceEndDate" class="form-label text-muted small fw-bold">Date to</label>
            <input type="date" name="endDate" id="resourceEndDate" class="form-control"
                   value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="dashboard-filter-field dashboard-distance-field">
            <label for="resourceRadiusFilter" class="form-label text-muted small fw-bold">Distance</label>
            <input id="resourceRadiusFilter" type="range" class="form-range" min="0" max="100" step="5" value="0" />
            <div class="dashboard-radius-value" id="resourceRadiusValue">All distances</div>
        </div>

        <div class="dashboard-filter-actions">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-controller="Resources" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <p id="resource-location-error" class="dashboard-location-error" role="alert" aria-live="polite" hidden>
        Location access is required to use the distance filter.
    </p>

    @if (!Model.Resources.Any())
    {
        <p class="placeholder-copy">No resources are registered right now.</p>
    }
    else
    {
        <div class="resource-list">
            @foreach (var resource in Model.Resources)
            {
                var normalizedStatus = (resource.Status ?? "").Trim().ToLowerInvariant();
                var statusClass = normalizedStatus switch
                {
                    "ny" or "new" => "status-new",
                    "available" => "status-available",
                    "assigned" => "status-assigned",
                    "under_review" => "status-under-review",
                    "rejected" => "status-rejected",
                    "unavailable" => "status-unavailable",
                    "withdrawn" => "status-withdrawn",
                    _ => ""
                };
                var statusText = normalizedStatus switch
                {
                    "ny" or "new" => "New",
                    "under_review" => "Under review",
                    _ => resource.Status
                };

                <article class="dashboard-card resource-card"
                         data-latitude="@resource.Latitude"
                         data-longitude="@resource.Longitude">
                    <div class="dashboard-card-header">
                        <h2>@resource.Name</h2>
                        <span class="status-label @statusClass">@statusText</span>
                    </div>

                    <p class="dashboard-card-description">@resource.Description</p>

                    <dl class="dashboard-details resource-details">
                        <div>
                            <dt>Type</dt>
                            <dd>@resource.Category?.CategoryName</dd>
                        </div>
                        <div>
                            <dt>Contact</dt>
                            <dd>@resource.Email<br />@resource.PhoneNumber</dd>
                        </div>
                        <div>
                            <dt>Location (lat/lng)</dt>
                            <dd>
                                @if (resource.Latitude.HasValue && resource.Longitude.HasValue)
                                {
                                    @($"{resource.Latitude:F5}, {resource.Longitude:F5}")
                                }
                                else
                                {
                                    @:No position selected
                                }
                            </dd>
                        </div>
                        <div>
                            <dt>Effective date</dt>
                            <dd>@resource.AvailableFrom.ToString("dd.MM.yyyy")</dd>
                        </div>
                        <div>
                            <dt>Expiry date</dt>
                            <dd>@(resource.ExpirationDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
                        </div>
                        <div>
                            <dt>Registered</dt>
                            <dd>@resource.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</dd>
                        </div>
                    </dl>

                    <div class="dashboard-card-footer">
                        <form class="dashboard-card-actions" asp-controller="Home" asp-action="DeleteResource"
                              asp-route-id="@resource.Id" method="post"
                              data-confirm="Are you sure you want to delete this resource?">
                            @Html.AntiForgeryToken()
                            <a asp-controller="Resources" asp-action="Index" asp-route-id="@resource.Id"
                               class="btn btn-sm btn-primary">Edit</a>
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (ViewBag.EditResource is H_st_2026_Gruppe_1.Models.ResourceEntry editResource)
{
    <div class="modal fade registration-modal" id="registrationModal" tabindex="-1"
         aria-labelledby="registrationModalTitle" aria-hidden="true" data-bs-backdrop="static"
         data-registration-modal data-open-registration-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="registrationModalTitle">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                        <span>Edit resource</span>
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close registration form"></button>
                </div>
                <div class="modal-body" data-registration-modal-body>
                    <partial name="~/Views/Home/_ResourceRegistrationForm.cshtml" model="editResource" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@Context.Items["CspNonce"]">
        window.resqRegistration.initializeDateTimeFields('resourceForm', [
            { dateId: 'availableFromDate', timeId: 'availableFromTime', valueId: 'availableFromValue' },
            { dateId: 'expiryDate', timeId: 'expirationTime', valueId: 'expirationValue',
              rangeErrorId: 'resourceDateRangeError' }
        ]);
        window.resqRegistration.bindCurrentLocationButton('useCurrentLocation', {
            onPosition: (latitude, longitude) => {
                document.getElementById('latInput').value = latitude;
                document.getElementById('lngInput').value = longitude;
                document.getElementById('posText').textContent =
                    'Selected position: lat: ' + latitude.toFixed(5) + ', lng: ' + longitude.toFixed(5);
            }
        });

        const modalElement = document.getElementById('registrationModal');
        if (modalElement?.dataset.openRegistrationModal === 'true') {
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }

        window.resqDateRange.bindFilter(
            'resourceFilterForm',
            'resourceStartDate',
            'resourceEndDate');
        window.resqRadius.initializeDistanceFilter({
            sliderId: 'resourceRadiusFilter',
            valueId: 'resourceRadiusValue',
            errorId: 'resource-location-error',
            cardSelector: '.resource-card'
        });
    </script>
}
