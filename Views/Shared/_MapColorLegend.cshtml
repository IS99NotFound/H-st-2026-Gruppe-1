<div class="map-color-legend" data-map-legend>
    <button type="button" class="map-color-legend-toggle" data-map-legend-toggle
            aria-expanded="true" aria-controls="map-color-legend-content">
        <span>Fargekoder</span>
        <i class="bi bi-chevron-down" aria-hidden="true"></i>
    </button>
    <div id="map-color-legend-content" class="map-color-legend-content">
        <div class="map-color-legend-item">
            <span class="map-color-dot map-color-dot--critical-need" aria-hidden="true"></span>
            <span><strong>Rød:</strong> Akutt behov</span>
        </div>
        <div class="map-color-legend-item">
            <span class="map-color-dot map-color-dot--planned-need" aria-hidden="true"></span>
            <span><strong>Gul:</strong> Planlagt behov</span>
        </div>
        <div class="map-color-legend-item">
            <span class="map-color-dot map-color-dot--available-resource" aria-hidden="true"></span>
            <span><strong>Grønn:</strong> Tilgjengelig ressurs</span>
        </div>
        <div class="map-color-legend-item">
            <span class="map-color-dot map-color-dot--public-team" aria-hidden="true"></span>
            <span><strong>Blå:</strong> Offentlig aktør</span>
        </div>
    </div>
</div>
