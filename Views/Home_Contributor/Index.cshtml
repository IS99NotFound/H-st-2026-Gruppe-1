@model H_st_2026_Gruppe_1.Models.ResourceViewModel
@{
    ViewData["Title"] = "Home Page";
    ViewData["FullWidth"] = true;
}
<div class="main-layout">

    <aside id="side-panel" class="side-panel" aria-label="Resource registration">
        <div class="side-panel-header">
            <div>
                <h1>Register a resource</h1>
            </div>
            <button class="panel-toggle panel-close" type="button" aria-controls="side-panel" aria-expanded="false">
                <span class="visually-hidden">Close resource panel</span>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        <!-- Form for registering a resource -->
        <form id="resourceForm" asp-controller="Home" asp-action="RegisterResource" method="post" novalidate>
            <div class="mb-2">
                <label for="nameInput">Full name</label>
                <input type="text" name="Name" id="nameInput" value="@Model.Name" class="form-control" required />
                <small id="nameError" class="text-danger"></small>
            </div>
            <div class="mb-2">
                <label for="contactInput">Contact information</label>
                <input type="text" name="Phone" id="contactInput" value="@Model.Phone" class="form-control" placeholder="Phone number or email" required />
                <small id="contactError" class="text-danger"></small>
            </div>
            <div class="mb-2"> 
                <label for="resourceType">Resource type</label>
                <select name="ResourceType" id="resourceType" class="form-control" required>
                    <option value="">Select a type</option>
                    <option value="Transport/logistics" selected="@(Model.ResourceType == "Transport/logistics" ? "selected" : null)">Transport / logistics</option>
                    <option value="Heavy machinery" selected="@(Model.ResourceType == "Heavy machinery" ? "selected" : null)">Heavy machinery e.g Tractor</option>
                    <option value="Power Supply / Generator" selected="@(Model.ResourceType == "Power Supply / Generator" ? "selected" : null)">Power supply e.g Generator</option>
                    <option value="Evacuation / Shelter" selected="@(Model.ResourceType == "Evacuation / Shelter" ? "selected" : null)">Evacuation / shelter</option>
                    <option value="Plowing & Snow Clearing" selected="@(Model.ResourceType == "Plowing & Snow Clearing" ? "selected" : null)">Plowing & Snow Clearing</option>
                    <option value="Manpower" selected="@(Model.ResourceType == "Manpower" ? "selected" : null)">Search and rescue team</option>
                    <option value="Medical" selected="@(Model.ResourceType == "Medical" ? "selected" : null)">Medical support</option>
                    <option value="Other" selected="@(Model.ResourceType == "Other" ? "selected" : null)">Other</option>
                </select>
                <small id="resourceTypeError" class="text-danger"></small>
            </div>
            <div class="mb-2">
                <label for="descriptionInput">Description</label>
                <textarea name="Description" id="descriptionInput" class="form-control">@Model.Description</textarea>
            </div>
            <div class="mb-2">
                <label for="expiryDate">Expiry date</label>
                <input type="date" name="ExpiryDate" id="expiryDate" value="@Model.ExpiryDate?.ToString("yyyy-MM-dd")" class="form-control" readonly />
            </div>

            <!-- Hidden fields edited when user clicks on the map  -->
            <input type="hidden" name="Latitude" id="latInput" value="@Model.Latitude" />
            <input type="hidden" name="Longitude" id="lngInput" value="@Model.Longitude" />
            <p id="posText" class="placeholder-text">No position marked on the map</p>
            <span asp-validation-for="Latitude" class="text-danger d-block mb-2" id="posError"></span>

            <button type="submit" class="btn btn-primary">Register resource</button>
        </form>
    </aside>

    <!-- Map size (2/3 of the width) -->
    <section class="map-area">
        <div id="map" role="application" aria-label="Interactive map"></div>
        <p id="map-status" class="map-status" role="status" aria-live="polite">Loading map ...</p>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>

    // Create map and start in Grimstad 
    const map = L.map('map').setView([58.4614, 8.7683], 13);
    // Mobilepanel uses this ref when the maps visible area decreases
    window.resqMap = map;

    // Add map tiles from openstreetmap 
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    const mapStatus = document.getElementById('map-status');
    mapStatus.textContent = 'The map is ready. Select a position or use your current location.';

    // Find users position and move map to location 
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function (position) {
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;

            map.setView([lat, lng], 13);
            L.marker([lat, lng]).addTo(map).bindPopup('You are here').openPopup();
            mapStatus.textContent = 'The map is showing your current location.';
        }, function (error) {
            console.log('Could not get position:', error.message);
            mapStatus.textContent = 'Your location could not be found. You can still select a position on the map.';
        });
    } else {
        console.log('This browser does not support geolocation');
        mapStatus.textContent = 'This browser does not support geolocation. Select a position on the map.';
    }

    // Retrieves elements for Javascript 
    const resourceType = document.getElementById('resourceType');
    const expiryDate = document.getElementById('expiryDate');
    const resourceForm = document.getElementById('resourceForm');
    const nameInput = document.getElementById('nameInput');
    const nameError = document.getElementById('nameError');
    const resourceTypeError = document.getElementById('resourceTypeError');
    const contactInput = document.getElementById('contactInput');
    const contactError = document.getElementById('contactError');

    // Show error message if a required field is empty 
    resourceForm.addEventListener('submit', function (event) {
        let hasErrors = false;

        if (!nameInput.value.trim()) {
            nameError.textContent = 'Name is required.';
            nameError.hidden = false;
            hasErrors = true;
        }

        if (!contactInput.value.trim()) {
            contactError.textContent = 'A phone number or email address is required.';
            contactError.hidden = false;
            hasErrors = true;
        }

        if (!resourceType.value) {
            resourceTypeError.textContent = 'Select a resource type.';
            resourceTypeError.hidden = false;
            hasErrors = true;
        }

        if (hasErrors) {
            event.preventDefault();
        }
    });

    // Hides error messages while user types 
    nameInput.addEventListener('input', function () {
        nameError.hidden = nameInput.value.trim() === '';
    });

    contactInput.addEventListener('input', function () {
        contactError.hidden = contactInput.value.trim() === '';
    });

    // Shows expiration date after user picks a resource type
    resourceType.addEventListener('change', function () {
        resourceTypeError.hidden = resourceType.value === '';
        const renewalDate = new Date();

        switch (resourceType.value) {
            case 'Heavy machinery':
            case 'Power Supply / Generator':
                renewalDate.setMonth(renewalDate.getMonth() + 6);
                break;
            case 'Medical':
                renewalDate.setMonth(renewalDate.getMonth() + 1);
                break;
            case 'Transport/logistics':
            case 'Evacuation / Shelter':
            case 'Plowing & Snow Clearing':
            case 'Manpower':
            case 'Other':
                renewalDate.setFullYear(renewalDate.getFullYear() + 1);
                break;
            default:
                expiryDate.value = '';
                return;
        }

        // Convert date to format yyyy-mm-dd 
        const year = renewalDate.getFullYear();
        const month = String(renewalDate.getMonth() + 1).padStart(2, '0');
        const day = String(renewalDate.getDate()).padStart(2, '0');
        expiryDate.value = `${year}-${month}-${day}`;
    });

    // Remember users marker so that it can be removed next click 
    let selectedMarker = null;

    // Stops form from being submittied if user hasn't picked a location on the map
    document.querySelector('form').addEventListener('submit', function (e) {
        const lat = document.getElementById('latInput').value;
        const posError = document.getElementById('posError');

        if (!lat) {
            e.preventDefault(); // Stops form from submitting
            if (posError) {
                posError.textContent = 'You have to choose a location on the map before you can finish registration';
            }
        }
    });

    // Remove error messages when user is clicking on the map 
    map.on('click', function (e) {
        const posError = document.getElementById('posError');
        if (posError) {
            posError.textContent = '';
        }
    });

    // Clicking on the map places marker and sends coordinates to form 
    map.on('click', function (e) {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        if (selectedMarker) {
            map.removeLayer(selectedMarker);
        }

        selectedMarker = L.marker([lat, lng]).addTo(map)
            .bindPopup('Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5))
            .openPopup();

        document.getElementById('latInput').value = lat;
        document.getElementById('lngInput').value = lng;
        document.getElementById('posText').innerText = 'Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5);
    });
</script>