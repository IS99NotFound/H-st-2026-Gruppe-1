@model H_st_2026_Gruppe_1.Models.ResourceNeed
@{
    ViewData["Title"] = "Public Actor Dashboard";
    ViewData["FullWidth"] = true;
    ViewData["RegistrationType"] = "need";
    var canRegisterResource = User.IsInRole("ResourceProvider") || User.IsInRole("Administrator");
    var openRegistrationModal = ViewBag.OpenRegistrationModal is bool shouldOpen
        ? shouldOpen
        : Context.Request.Query["register"] == "need";
}

<div class="main-layout registration-modal-page">
    <partial name="_OperationalFeed" />
    <div class="feed-resizer" role="separator" aria-orientation="vertical"
         aria-label="Resize operational feed" tabindex="0"></div>
    <section class="map-area">
        <div id="map" role="application" aria-label="Interactive map"
             data-resource-registration-url="@(canRegisterResource ? Url.Action("Index", "Home") : null)"
             data-need-registration-url="@Url.Action("DashboardIndex", "PublicActor")"
             data-registration-type="need"></div>
        <div class="map-filtering is-collapsed" id="survival-filter-panel">
            <div class="map-filter-header">
                <button type="button" id="survival-filter-button" class="map-filter-button"
                        aria-expanded="false" aria-controls="survival-filter-content"
                        aria-label="Collapse registered resource filters">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
                <strong class="map-filter-title">Filter registered resources</strong>
            </div>
            <div id="survival-filter-content">
                <div class="map-filter-options">
                    @foreach (var resourceType in new[] { "Drone", "ATV", "Tractor", "Generator", "Excavator", "Truck", "Boat", "Sand/Gravel", "Other" })
                    {
                        <label><input type="checkbox" class="registered-resources-filter" value="@resourceType" checked /> @resourceType</label>
                    }
                </div>
                <p id="registered-resources-status" role="status">Loading registered resources...</p>
            </div>
        </div>
        <p id="map-status" class="map-status" role="status" aria-live="polite">Loading map ...</p>
    </section>
</div>

<div class="modal fade registration-modal" id="registrationModal" tabindex="-1"
     aria-labelledby="registrationModalTitle" aria-hidden="true" data-bs-backdrop="static"
     data-registration-modal data-open-registration-modal="@(openRegistrationModal ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-4" id="registrationModalTitle">
                    <i class="bi bi-clipboard-plus me-2" aria-hidden="true"></i>Register resource need
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close registration form"></button>
            </div>
            <div class="modal-body" data-registration-modal-body>
                <partial name="_NeedRegistrationForm" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.publicActorResources = @Html.Raw(ViewBag.ResourceMarkersJson ?? "[]");
    </script>
    <script src="~/js/map-registration.js" asp-append-version="true"></script>
    <script src="~/js/public-actor-resource-filters.js" asp-append-version="true" defer></script>
    <script src="~/js/map-filter-button.js" asp-append-version="true" defer></script>
    <script>
        window.operationalFeedIncidents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ViewBag.FeedIncidents ?? new List<object>(),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    </script>
    <script src="~/js/operational-feed.js" asp-append-version="true" defer></script>
    <script>
        const map = L.map('map').setView([58.4614, 8.7683], 13);
        window.resqMap = map;
        const mapElement = document.getElementById('map');
        const registrationLinks = window.resqMapRegistration.bind(map, {
            resource: mapElement.dataset.resourceRegistrationUrl,
            need: mapElement.dataset.needRegistrationUrl,
            currentType: mapElement.dataset.registrationType
        });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);
        document.getElementById('map-status').textContent =
            'Map ready. Select position for the crisis need.';

        let selectedMarker = null;
        let abMode = null;
        let markerA = null;
        let markerB = null;
        let abLine = null;
        let abButton = null;
        const latInput = document.getElementById('latInput');
        const lngInput = document.getElementById('lngInput');
        const requestedLocation = window.resqMapRegistration.readRequestedLocation();
        const initialLat = Number(latInput?.value);
        const initialLng = Number(lngInput?.value);
        const selectedLat = requestedLocation?.lat ?? initialLat;
        const selectedLng = requestedLocation?.lng ?? initialLng;

        function setPosition(lat, lng) {
            selectedMarker && map.removeLayer(selectedMarker);
            selectedMarker = L.marker([lat, lng]).addTo(map)
                .bindPopup('Need location: ' + lat.toFixed(5) + ', ' + lng.toFixed(5))
                .openPopup();
            latInput.value = lat;
            lngInput.value = lng;
            document.getElementById('posText').textContent =
                'Selected position: lat: ' + lat.toFixed(5) + ', lng: ' + lng.toFixed(5);
            document.getElementById('posError').textContent = '';
        }

        function createAbIcon(letter) {
            return L.divIcon({
                className: '',
                html: '<div class="ab-marker"><span>' + letter + '</span></div>',
                iconSize: [28, 28],
                iconAnchor: [13, 34]
            });
        }

        function resetAb() {
            if (markerA) map.removeLayer(markerA);
            if (markerB) map.removeLayer(markerB);
            if (abLine) map.removeLayer(abLine);
            markerA = markerB = abLine = null;
        }

        const AbControl = L.Control.extend({
            options: { position: 'topleft' },
            onAdd: function () {
                const container = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
                abButton = L.DomUtil.create('a', 'ab-button', container);
                abButton.href = '#';
                abButton.title = 'Mark point A and B';
                abButton.setAttribute('role', 'button');
                abButton.innerHTML = '<span aria-hidden="true">A-B</span>';
                L.DomEvent.disableClickPropagation(container);
                L.DomEvent.on(abButton, 'click', function (event) {
                    L.DomEvent.preventDefault(event);
                    if (abMode) {
                        abMode = null;
                        abButton.classList.remove('active');
                    } else {
                        resetAb();
                        abMode = 'A';
                        abButton.classList.add('active');
                    }
                });
                return container;
            }
        });
        new AbControl().addTo(map);

        if (Number.isFinite(selectedLat) && Number.isFinite(selectedLng) &&
            (requestedLocation || selectedLat !== 0 || selectedLng !== 0)) {
            setPosition(selectedLat, selectedLng);
            map.setView([selectedLat, selectedLng], 13);
        } else if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(position =>
                map.setView([position.coords.latitude, position.coords.longitude], 13));
        }
        map.on('click', event => {
            if (abMode === 'A') {
                markerA = L.marker(event.latlng, { icon: createAbIcon('A') }).addTo(map);
                abMode = 'B';
                return;
            }
            if (abMode === 'B') {
                markerB = L.marker(event.latlng, { icon: createAbIcon('B') }).addTo(map);
                abLine = L.polyline([markerA.getLatLng(), markerB.getLatLng()], {
                    color: '#ff8c00', weight: 4, dashArray: '8 6'
                }).addTo(map);
                map.fitBounds(abLine.getBounds(), { padding: [60, 60] });
                abMode = null;
                abButton.classList.remove('active');
                return;
            }
            setPosition(event.latlng.lat, event.latlng.lng);
            registrationLinks(event.latlng);
        });
        document.getElementById('needForm')?.addEventListener('submit', event => {
            if (!latInput.value || latInput.value === '0') {
                event.preventDefault();
                document.getElementById('posError').textContent =
                    'Position on the map is required.';
            }
        });
        const modalElement = document.getElementById('registrationModal');
        if (modalElement.dataset.openRegistrationModal === 'true') {
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }
    </script>
}
