@{
    ViewData["Title"] = "Needs";
}

<section class="subpage">
    <div class="subpage-header">
        <h1>Needs</h1>
        <a asp-controller="PublicActor" asp-action="DashboardIndex" class="btn btn-primary">Register need</a>
    </div>
   <form method="get" asp-controller="PublicActor" asp-action="NeedsIndex" class="row g-3 mb-4 align-items-end">
    
    <!-- Filter på Prioritet -->
    <div class="col-md-4">
        <label for="priorityFilter" class="form-label text-muted small fw-bold">Filter by Priority</label>
        <select name="priority" id="priorityFilter" class="form-select">
            <option value="">All Priorities</option>
            <option value="Critical" selected="@(Context.Request.Query["priority"] == "Critical")">Critical</option>
            <option value="Urgent" selected="@(Context.Request.Query["priority"] == "Urgent")">Urgent</option>
            <option value="Planned" selected="@(Context.Request.Query["priority"] == "Planned")">Planned</option>
        </select>
    </div>

    <!-- Filter på Kategori -->
    <div class="col-md-4">
        <label for="categoryFilter" class="form-label text-muted small fw-bold">Filter by Category</label>
        <select name="category" id="categoryFilter" class="form-select">
            <option value="">All Categories</option>
            @foreach (var category in (List<Category>)ViewBag.Categories)
            {
                <option value="@category.CategoryId" selected="@(Context.Request.Query["category"] == category.CategoryId.ToString())">@category.CategoryName</option>
            }
        </select>
    </div>

    <!-- Knapper -->
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-controller="PublicActor" asp-action="NeedsIndex" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>
    
    @if (!Model.Any())
{
    <p class="placeholder-copy">No needs are registered right now</p>
}
else
{
    
    <div class="table-wrapper">
    <table class="table table-dark table-striped">
        <thead>
        <tr>
            <th>Title</th>
            <th>Contact info</th>
            <th>Crisis incident</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Description</th>
            <th>Needed from</th>
            <th>Needed until</th>
            <th>Lat/Lng</th>
            <th>Registered</th>
            <th>Priority</th>
            <th>Status</th>
            
        </tr>
        </thead>
        
        <tbody>
            @foreach (var need in Model)
            {
                <tr>
                    <td>@need.Title</td>
                    <td>@need.ContactInfo</td>
                    <td>@need.CrisisEventId</td>
                    <td>@(need.CategoryInfo?.CategoryName ?? "Unspecified")</td>
                    <td>@need.Quantity</td>
                    <td>@need.Description</td>
                    <td>@(need.RequiredFrom?.ToString("dd.MM.yyyy") ?? "Not specified")</td>
                    <td>@(need.Deadline?.ToString("dd.MM.yyyy") ?? "Not specified")</td>
                    <td>
                    @if (need.Latitude != null && need.Longitude != null)
                    {
                        @($"{need.Latitude:F5}, {need.Longitude:F5}")
                    }
                    else
                    {
                        <span>No position selected</span>
                    }
                    </td>
                    <td>@need.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @switch (need.Priority)
                        {
                            case  NeedPriorityEnum.Planned:
                                <span class="badge bg-secondary d-inline-flex align-items-center gap-1 px-2 py-1" title="Planned">
                                    <i class="bi bi-calendar-event"></i>
                                    <span>Planned</span>
                                </span>
                                break;
                            case NeedPriorityEnum.Urgent:
                                <span class="badge bg-warning text-dark d-inline-flex align-items-center gap-1 px-2 py-1" title="Urgent">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <span>Urgent</span>
                                </span>
                                break;

                            case NeedPriorityEnum.Critical:
                                <span class="badge bg-danger d-inline-flex align-items-center gap-1 px-2 py-1" title="Critical">
                                    <i class="bi bi-fire"></i>
                                    <span>Critical</span>
                                </span>
                                break;
                        }
                    </td>
                    <td><span class="status-label">@(need.Status == "Ny" ? "New" : need.Status)</span></td>
                    
                 
                </tr>
            }
        </tbody>
    </table>
    </div>
}
</section>