@model IReadOnlyList<H_st_2026_Gruppe_1.Models.IncidentReportRow>

@{
    ViewData["Title"] = "Hendelsesrapport";
}

<section class="subpage report-page">
    <div class="subpage-header">
        <div>
            <h1>Hendelsesrapport</h1>
            <p class="page-intro">Oversikt over alle registrerte hendelser.</p>
        </div>
        <div class="d-flex gap-2 report-actions">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Tilbake
            </a>
            <button type="button" class="btn btn-primary" id="printReportButton">
                <i class="bi bi-printer me-1" aria-hidden="true"></i>Skriv ut / Lagre som PDF
            </button>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="table-wrapper">
            <table class="table table-striped align-middle mb-0">
                <caption class="visually-hidden">Registrerte hendelser</caption>
                <thead>
                    <tr>
                        <th scope="col">Tittel</th>
                        <th scope="col">Type</th>
                        <th scope="col">Beskrivelse</th>
                        <th scope="col">Region</th>
                        <th scope="col">Breddegrad</th>
                        <th scope="col">Lengdegrad</th>
                        <th scope="col">Status</th>
                        <th scope="col">Registrert</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var incident in Model)
                {
                    <tr>
                        <td>@incident.Title</td>
                        <td>@incident.IncidentType</td>
                        <td>@incident.Description</td>
                        <td>@incident.RegionName</td>
                        <td>@incident.Latitude</td>
                        <td>@incident.Longitude</td>
                        <td>@StatusLabelHelper.DisplayName(incident.Status)</td>
                        <td>@incident.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script nonce="@Context.Items["CspNonce"]">
    document.getElementById("printReportButton")?.addEventListener("click", () => window.print());
</script>
