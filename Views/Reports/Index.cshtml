@model H_st_2026_Gruppe_1.Models.ReportsIndexViewModel

@{
    ViewData["Title"] = "Rapportoversikt";
}

<section class="subpage report-overview">
    <div class="subpage-header report-overview-header">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="page-intro">Se status og registreringer for ressurser, hendelser og behov.</p>
        </div>
        <a asp-action="ExportAllCsv"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
           asp-route-category="@Model.Category"
           asp-route-location="@Model.Location"
           class="btn btn-primary report-export-button">
            <i class="bi bi-download me-2" aria-hidden="true"></i>Eksporter alt til CSV
        </a>
    </div>

    <form method="get" asp-action="Index" class="dashboard-filter-bar report-filter-bar">
        <div class="dashboard-filter-field">
            <label for="fromDate" class="form-label text-muted small fw-bold">Fra dato</label>
            <input type="date" class="form-control" id="fromDate" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
        </div>
        <div class="dashboard-filter-field">
            <label for="toDate" class="form-label text-muted small fw-bold">Til dato</label>
            <input type="date" class="form-control" id="toDate" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
        </div>
        <div class="dashboard-filter-field">
            <label for="category" class="form-label text-muted small fw-bold">Kategori</label>
            <select class="form-select" id="category" name="category">
                <option value="">Alle kategorier</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.Category == category.Id ? "selected" : null)">@CategoryLabelHelper.DisplayName(category.Name)</option>
                }
            </select>
        </div>
        <div class="dashboard-filter-field">
            <label for="location" class="form-label text-muted small fw-bold">Område / sted</label>
            <input type="text" class="form-control" id="location" name="location" value="@Model.Location" placeholder="F.eks. Sentrum">
        </div>
        <div class="dashboard-filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filtrer
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Nullstill</a>
        </div>
    </form>

    <div class="report-stat-grid">
        <article class="dashboard-card report-stat-card report-stat-card--incidents">
            <div class="report-stat-icon report-stat-icon-incidents"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
            <div class="report-stat-content">
                <h2>Hendelser</h2>
                <p class="report-stat-total">@Model.TotalIncidents <span>totalt</span></p>
                <div class="report-stat-details">
                    <span><i class="bi bi-circle-fill" aria-hidden="true"></i>@Model.ActiveIncidents aktive</span>
                    <span><i class="bi bi-check-circle-fill" aria-hidden="true"></i>@Model.ResolvedIncidents løste</span>
                </div>
            </div>
        </article>
        <article class="dashboard-card report-stat-card report-stat-card--needs">
            <div class="report-stat-icon report-stat-icon-needs"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></div>
            <div class="report-stat-content">
                <h2>Behov</h2>
                <p class="report-stat-total">@Model.TotalNeeds <span>totalt</span></p>
                <div class="report-stat-details">
                    <span class="report-stat-attention"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>@Model.UnansweredNeedsCount ubesvarte</span>
                </div>
            </div>
        </article>
        <article class="dashboard-card report-stat-card report-stat-card--resources">
            <div class="report-stat-icon report-stat-icon-resources"><i class="bi bi-box-seam" aria-hidden="true"></i></div>
            <div class="report-stat-content">
                <h2>Ressurser</h2>
                <p class="report-stat-total">@Model.TotalResources <span>totalt</span></p>
                <div class="report-stat-details">
                    <span><i class="bi bi-check-circle-fill" aria-hidden="true"></i>@Model.AvailableResources tilgjengelige</span>
                    <span><i class="bi bi-dash-circle-fill" aria-hidden="true"></i>@Model.ResourcesInUse utilgjengelige</span>
                </div>
            </div>
        </article>
    </div>

    <section class="dashboard-card report-table-card">
        <div class="report-table-heading">
            <button class="report-section-toggle" type="button" data-bs-toggle="collapse"
                    data-bs-target="#resources-table" aria-expanded="false" aria-controls="resources-table">
                <span>
                    <span class="page-eyebrow">OVERSIKT</span>
                    <span class="report-section-title">Ressurser</span>
                </span>
                <span class="report-section-meta">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
        </div>
        <div class="collapse" id="resources-table">
            <div class="table-wrapper">
                <table class="table table-striped table-hover align-middle mb-0">
                    <caption class="visually-hidden">Registrerte ressurser</caption>
                    <thead>
                        <tr>
                            <th scope="col">Navn</th>
                            <th scope="col">Kategori</th>
                            <th scope="col">Beskrivelse</th>
                            <th scope="col">Sted</th>
                            <th scope="col">Status</th>
                            <th scope="col">Registrert</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var resource in Model.Resources)
                        {
                            <tr>
                                <td>@resource.Name</td>
                                <td>@CategoryLabelHelper.DisplayName(resource.Category)</td>
                                <td>@resource.Description</td>
                                <td>@resource.LocationName</td>
                                <td>@StatusLabelHelper.DisplayName(resource.Status)</td>
                                <td>@resource.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (!Model.Resources.Any())
                        {
                            <tr><td colspan="6" class="report-empty-state">Ingen ressurser funnet for valgte filtre.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="dashboard-card report-table-card">
        <div class="report-table-heading">
            <button class="report-section-toggle" type="button" data-bs-toggle="collapse"
                    data-bs-target="#incidents-table" aria-expanded="false" aria-controls="incidents-table">
                <span>
                    <span class="page-eyebrow">OVERSIKT</span>
                    <span class="report-section-title">Hendelser</span>
                </span>
                <span class="report-section-meta">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
        </div>
        <div class="collapse" id="incidents-table">
            <div class="table-wrapper">
                <table class="table table-striped table-hover align-middle mb-0">
                    <caption class="visually-hidden">Registrerte hendelser</caption>
                    <thead>
                        <tr>
                            <th scope="col">Tittel</th>
                            <th scope="col">Type</th>
                            <th scope="col">Beskrivelse</th>
                            <th scope="col">Posisjon</th>
                            <th scope="col">Status</th>
                            <th scope="col">Registrert</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var incident in Model.Incidents)
                        {
                            <tr>
                                <td>@incident.Title</td>
                                <td>@incident.IncidentType</td>
                                <td>@incident.Description</td>
                                <td>@incident.Latitude, @incident.Longitude</td>
                                <td>@StatusLabelHelper.DisplayName(incident.Status)</td>
                                <td>@incident.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (!Model.Incidents.Any())
                        {
                            <tr><td colspan="6" class="report-empty-state">Ingen hendelser funnet for valgte filtre.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="dashboard-card report-table-card">
        <div class="report-table-heading">
            <button class="report-section-toggle" type="button" data-bs-toggle="collapse"
                    data-bs-target="#needs-table" aria-expanded="false" aria-controls="needs-table">
                <span>
                    <span class="page-eyebrow">OVERSIKT</span>
                    <span class="report-section-title">Behov</span>
                </span>
                <span class="report-section-meta">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
        </div>
        <div class="collapse" id="needs-table">
            <div class="table-wrapper">
                <table class="table table-striped table-hover align-middle mb-0">
                    <caption class="visually-hidden">Registrerte behov</caption>
                    <thead>
                        <tr>
                            <th scope="col">Tittel</th>
                            <th scope="col">Kategori</th>
                            <th scope="col">Sted</th>
                            <th scope="col">Status</th>
                            <th scope="col">Prioritet</th>
                            <th scope="col">Registrert</th>
                            <th scope="col">Frist</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var need in Model.Needs)
                        {
                            <tr>
                                <td>@need.Title</td>
                                <td>@need.Category</td>
                                <td>@need.LocationName</td>
                                <td>@StatusLabelHelper.DisplayName(need.Status)</td>
                                <td>@need.Priority</td>
                                <td>@need.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(need.Deadline.HasValue ? need.Deadline.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                            </tr>
                        }
                        @if (!Model.Needs.Any())
                        {
                            <tr><td colspan="7" class="report-empty-state">Ingen behov funnet for valgte filtre.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</section>