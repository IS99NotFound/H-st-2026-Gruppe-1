@{
    ViewData["Title"] = "Home Page";
}
<div class="main-layout">

    <!-- Område designert for annet, f.eks. skjema -->
    <aside class="side-panel">
        <p class="placeholder-text">Form</p>

        <!-- Skjema for å registrere en ressurs -->
        <form asp-controller="Home" asp-action="RegisterResource" method="post">
            <div class="mb-2">
                <label>Full name</label>
                <input type="text" name="Name" class="form-control" required />
            </div>
            <div class="mb-2">
                <label>Contact information</label>
                <input type="text" name="Phone" class="form-control" placeholder="Phone number or email" />
            </div>
            <div class="mb-2">
                <label>Resource type</label>
                <select name="ResourceType" class="form-control">
                    <option value="Shelter">Shelter</option>
                    <option value="Mat">Food</option>
                    <option value="Transport">Transport</option>
                    <option value="Medisinsk">Medical</option>
                    <option value="Annet">Other</option>
                </select>
            </div>
            <div class="mb-2">
                <label>Description</label>
                <textarea name="Description" class="form-control"></textarea>
            </div>

            <!-- Fylles ut av JS når man klikker i kartet -->
            <input type="hidden" name="Latitude" id="latInput" />
            <input type="hidden" name="Longitude" id="lngInput" />
            <p id="posText" class="placeholder-text">No position marked on the map</p>

            <button type="submit" class="btn btn-primary">Register resource</button>
        </form>
    </aside>

    <!-- Område designert kart (2/3) -->
    <section class="map-area">
        <div id="map"></div>
    </section>

</div>

<script>
    var map = L.map('map').setView([58.4614, 8.7683], 13); // Fallback mens vi venter
    // Funksjon for å kjøre leaflet script for å hente kart
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    if (navigator.geolocation) //Henter koordinater for kart
    {navigator.geolocation.getCurrentPosition(function (position) {
            var lat = position.coords.latitude;
            var lng = position.coords.longitude;

            map.setView([lat, lng], 13); // Melding til bruker avhengig av om det gikk å hente lokasjon eller ikke
            L.marker([lat, lng]).addTo(map).bindPopup('You are here').openPopup();
        }, function (error) {
            console.log('Could not get position:', error.message);
        });
    } else {
        console.log('Webbrowser does not support geolocation');
    }

    var valgtMarkør = null; // Markør holder seg der den skal

    map.on('click', function (e) {
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        if (valgtMarkør) {
            map.removeLayer(valgtMarkør); // Fjern gammel markør så du ikke har flere markører samtidig
        }

        valgtMarkør = L.marker([lat, lng]).addTo(map)
            .bindPopup('Chosen position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5))
            .openPopup();

        // Sender posisjonen inn i skjemaet så den blir med når man trykker registrer
        document.getElementById('latInput').value = lat;
        document.getElementById('lngInput').value = lng;
        document.getElementById('posText').innerText = 'Chosen position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5);
    });
</script>