@model H_st_2026_Gruppe_1.Models.ResourceEntry
@{
    ViewData["Title"] = "Home Page";
    ViewData["FullWidth"] = true;
}
<div class="main-layout">

    <aside id="side-panel" class="side-panel" aria-label="Resource registration">
        <div class="side-panel-header">
            <div>
                <h1>Register a resource</h1>
            </div>
            <button class="panel-toggle panel-close" type="button" aria-controls="side-panel" aria-expanded="false">
                <span class="visually-hidden">Close resource panel</span>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        <!-- Form for registering a resource -->
        <form id="resourceForm" asp-controller="Home" asp-action="RegisterResource" method="post">
            <div class="mb-2">
                <label asp-for="Name">Full name</label>
                <input asp-for="Name" id="nameInput" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Phone">Contact information</label>
                <input asp-for="Phone" id="contactInput" class="form-control" placeholder="Phone number or email" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="ResourceType">Resource type</label>
                <select asp-for="ResourceType" id="resourceType" class="form-control">
                    <option value="" selected disabled hidden>-- Select a resource type --</option>
                    <option value="Shelter">Shelter</option>
                    <option value="Mat">Food</option>
                    <option value="Transport">Transport</option>
                    <option value="Medisinsk">Medical</option>
                    <option value="Materialer">Materialer</option>
                    <option value="Annet">Other</option>
                </select>
                <span asp-validation-for="ResourceType" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" id="descriptionInput" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="ExpirationDate">Expiration date</label>
                <input type="date" asp-for="ExpirationDate" id="expiryDate" class="form-control" />
                <span asp-validation-for="ExpirationDate" class="text-danger"></span>

            </div>

            <!-- Filled by JavaScript when the user clicks the map -->
            <input type="hidden" asp-for="Latitude" id="latInput" />
            <input type="hidden" asp-for="Longitude" id="lngInput" />
            <p id="posText" class="placeholder-text">
                @(Model.Latitude != null && Model.Longitude != null 
                    ? $"Selected position: {Model.Latitude:F5}, {Model.Longitude:F5}" 
                    : "No position marked on the map")
            </p>
            <span asp-validation-for="Latitude" class="text-danger d-block mb-2" id="posError"></span>

            <button type="submit" class="btn btn-primary">Register resource</button>
        </form>
    </aside>

    <!-- Map area (2/3) -->
    <section class="map-area">
        <div id="map" role="application" aria-label="Interactive map"></div>
        <p id="map-status" class="map-status" role="status" aria-live="polite">Loading map ...</p>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const map = L.map('map').setView([58.4614, 8.7683], 13);
        // The mobile panel uses this reference when the map's visible size changes.
        window.resqMap = map;

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const mapStatus = document.getElementById('map-status');
        mapStatus.textContent = 'The map is ready. Select a position or use your current location.';

        let selectedMarker = null;

        // If coordinates already exist (e.g. returning after server validation error), place the marker
        const initialLat = parseFloat(document.getElementById('latInput').value);
        const initialLng = parseFloat(document.getElementById('lngInput').value);
        if (!isNaN(initialLat) && !isNaN(initialLng)) {
            map.setView([initialLat, initialLng], 13);
            selectedMarker = L.marker([initialLat, initialLng]).addTo(map)
                .bindPopup('Selected position: ' + initialLat.toFixed(5) + ', ' + initialLng.toFixed(5))
                .openPopup();
        } else if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;

                map.setView([lat, lng], 13);
                L.marker([lat, lng]).addTo(map).bindPopup('You are here').openPopup();
                mapStatus.textContent = 'The map is showing your current location.';
            }, function (error) {
                console.log('Could not get position:', error.message);
                mapStatus.textContent = 'Your location could not be found. You can still select a position on the map.';
            });
        } else {
            console.log('This browser does not support geolocation');
            mapStatus.textContent = 'This browser does not support geolocation. Select a position on the map.';
        }

        const resourceType = document.getElementById('resourceType');
        const expiryDate = document.getElementById('expiryDate');
        const resourceForm = document.getElementById('resourceForm');

        function updateExpiryDate() {
            if (!resourceType.value) {
                expiryDate.value = '';
                return;
            }

            const renewalDate = new Date();

            switch (resourceType.value) {
                case 'Mat':
                    renewalDate.setDate(renewalDate.getDate() + 14);
                    break;
                case 'Medisinsk':
                    renewalDate.setMonth(renewalDate.getMonth() + 1);
                    break;
                case 'Materialer':
                    renewalDate.setMonth(renewalDate.getMonth() + 6);
                    break;
                case 'Shelter':
                case 'Transport':
                case 'Annet':
                    renewalDate.setFullYear(renewalDate.getFullYear() + 1);
                    break;
                default:
                    expiryDate.value = '';
                    return;
            }

            const year = renewalDate.getFullYear();
            const month = String(renewalDate.getMonth() + 1).padStart(2, '0');
            const day = String(renewalDate.getDate()).padStart(2, '0');
            expiryDate.value = `${year}-${month}-${day}`;
        }

        // Calculate expiry date on resource category change
        resourceType.addEventListener('change', updateExpiryDate);

        // Map click event
        map.on('click', function (e) {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;

            if (selectedMarker) {
                map.removeLayer(selectedMarker);
            }

            selectedMarker = L.marker([lat, lng]).addTo(map)
                .bindPopup('Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5))
                .openPopup();

            document.getElementById('latInput').value = lat;
            document.getElementById('lngInput').value = lng;
            document.getElementById('posText').innerText = 'Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5);

            const posError = document.getElementById('posError');
            if (posError) {
                posError.textContent = '';
            }
        });

        // Form submit check for map selection
        resourceForm.addEventListener('submit', function (e) {
            const lat = document.getElementById('latInput').value;
            const posError = document.getElementById('posError');

            if (!lat) {
                e.preventDefault();
                if (posError) {
                    posError.textContent = 'Position on the map must be filled out';
                }
            }
        });
    </script>
}
