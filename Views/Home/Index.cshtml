@model H_st_2026_Gruppe_1.Models.ResourceEntry
@{
    ViewData["Title"] = "Startside";
    ViewData["FullWidth"] = true;
    ViewData["RegistrationType"] = "resource";
    var canRegisterNeed = User.IsInRole("PublicActor") || User.IsInRole("Administrator");
    var openRegistrationModal = ViewBag.OpenRegistrationModal is bool shouldOpen
        ? shouldOpen
        : Context.Request.Query["register"] == "resource" ||
          Model.Id > 0;
    
}

<div class="main-layout registration-modal-page">
    <partial name="_OperationalFeed" />
    <div class="feed-resizer" role="separator" aria-orientation="vertical"
         aria-label="Endre størrelse på operativ oversikt" tabindex="0"></div>
    <section class="map-area">
        <div id="map" role="application" aria-label="Interaktivt kart"
             data-resource-registration-url="@Url.Action("Index", "Home")"
             data-need-registration-url="@(canRegisterNeed ? Url.Action("DashboardIndex", "PublicActor") : null)"
             data-registration-type="resource"></div>
        <partial name="_MapColorLegend" />
        <div class="map-filtering is-collapsed" id="survival-filter-panel">
            <div class="map-filter-header">
                <strong class="map-filter-title">Filtrer steder</strong>
                <button type="button" id="survival-filter-button" class="map-filter-button"
                        aria-expanded="false" aria-controls="survival-filter-content"
                        aria-label="Utvid filter for beredskapssteder">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
            <div id="survival-filter-content">
                <div class="map-filter-options">
                    <label><input type="checkbox" class="survival-filter" value="hospital" checked /> Sykehus</label>
                    <label><input type="checkbox" class="survival-filter" value="drinking_water" checked /> Drikkevann</label>
                    <label><input type="checkbox" class="survival-filter" value="shelter" checked /> Tilfluktsrom/bunkere</label>
                </div>
                <p id="survival-filter-status" role="status">Laster eksisterende steder...</p>
            </div>
        </div>
        <p id="map-status" class="map-status" role="status" aria-live="polite">Laster kart ...</p>
    </section>
</div>

<div class="modal fade registration-modal" id="registrationModal" tabindex="-1"
     aria-labelledby="registrationModalTitle" aria-hidden="true" data-bs-backdrop="static"
     data-registration-modal data-open-registration-modal="@(openRegistrationModal ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="registrationModalTitle">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    <span>@(Model.Id > 0 ? "Rediger ressurs" : "Registrer en ressurs")</span>
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Lukk registreringsskjema"></button>
            </div>
            <div class="modal-body" data-registration-modal-body>
                <partial name="_ResourceRegistrationForm" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/map-base.js" asp-append-version="true"></script>
    <script src="~/js/map-reverse-geocode.js" asp-append-version="true"></script>
    <script src="~/js/map-registration.js" asp-append-version="true"></script>
    <script src="~/js/map-ab.js" asp-append-version="true"></script>
    <script src="~/js/survival-location-filters.js" asp-append-version="true" defer></script>
    <script src="~/js/map-filter-button.js" asp-append-version="true" defer></script>
    <script nonce="@Context.Items["CspNonce"]">
        window.operationalFeedItems = {
            resources: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ViewBag.FeedResources ?? new List<object>(),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),
            needs: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ViewBag.FeedNeeds ?? new List<object>(),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),
            incidents: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ViewBag.FeedIncidents ?? new List<object>(),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
        };
    </script>
    <script src="~/js/operational-feed.js" asp-append-version="true" defer></script>
    <script nonce="@Context.Items["CspNonce"]">
        window.resqRegistration.initializeDateTimeFields('resourceForm', [
            { dateId: 'availableFromDate', timeId: 'availableFromTime', valueId: 'availableFromValue' },
            { dateId: 'expiryDate', timeId: 'expirationTime', valueId: 'expirationValue',
              rangeErrorId: 'resourceDateRangeError' }
        ]);

        // Felles kartoppsett brukes også her, mens denne siden beholder filteret for beredskapssteder.
        const mapSetup = window.resqMapBase.initialize({
            center: [58.4614, 8.7683],
            zoom: 13
        });
        const map = mapSetup.map;
        window.resqMap = map;
        const mapElement = document.getElementById('map');
        const registrationLinks = window.resqMapRegistration.bind(map, {
            resource: mapElement.dataset.resourceRegistrationUrl,
            need: mapElement.dataset.needRegistrationUrl,
            currentType: mapElement.dataset.registrationType
        });
        document.getElementById('map-status').textContent =
            'Kartet er klart. Velg en posisjon eller bruk din nåværende posisjon.';

        const latInput = document.getElementById('latInput');
        const lngInput = document.getElementById('lngInput');
        const setPosition = window.resqMapRegistration.bindSelectedPosition(map, {
            latInput: latInput,
            lngInput: lngInput,
            positionText: document.getElementById('posText'),
            positionError: document.getElementById('posError'),
            popupText: 'Valgt posisjon',
            locationInput: document.getElementById('locationNameInput')
        });
        document.getElementById('searchLocationButton')?.addEventListener('click', async () => {
            const input = document.getElementById('locationNameInput');
            const button = document.getElementById('searchLocationButton');
            if (!input?.value.trim()) return;
            button.disabled = true;
            try {
                const result = await window.resqReverseGeocode.searchAddress(input.value.trim());
                if (!result) {
                    input.setCustomValidity('Fant ingen adresse.');
                    input.reportValidity();
                    return;
                }
                input.setCustomValidity('');
                input.value = result.formatted_query;
                setPosition(Number(result.lat), Number(result.lon), { preserveLocationName: true });
                map.setView([Number(result.lat), Number(result.lon)], 14);
            } catch {
                input.setCustomValidity('Adressesøket kunne ikke gjennomføres.');
                input.reportValidity();
            } finally {
                button.disabled = false;
            }
        });
        const requestedLocation = window.resqMapRegistration.readRequestedLocation();
        const initialLat = Number(latInput?.value);
        const initialLng = Number(lngInput?.value);
        const selectedLat = requestedLocation?.lat ?? initialLat;
        const selectedLng = requestedLocation?.lng ?? initialLng;

        if (Number.isFinite(selectedLat) && Number.isFinite(selectedLng) &&
            (requestedLocation || selectedLat !== 0 || selectedLng !== 0)) {
            setPosition(selectedLat, selectedLng);
            map.setView([selectedLat, selectedLng], 13);
        } else if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(position =>
                map.setView([position.coords.latitude, position.coords.longitude], 13));
        }
        window.resqAbMap.initialize(map, {
            onMapClick: event => {
                setPosition(event.latlng.lat, event.latlng.lng);
                registrationLinks(event.latlng);
            }
        });
        // A-B legges til før Layers for å få ønsket rekkefølge på kartkontrollene.
        mapSetup.addLayersControl();

        document.getElementById('resourceType')?.addEventListener('change', event => {
            const expiryDate = document.getElementById('expiryDate');
            const renewalDate = new Date();
            switch (event.target.value) {
                case 'Medical':
                    renewalDate.setMonth(renewalDate.getMonth() + 1);
                    break;
                case 'Heavy machinery':
                case 'Power Supply / Generator':
                    renewalDate.setMonth(renewalDate.getMonth() + 6);
                    break;
                case 'Transport/logistics':
                case 'Evacuation / Shelter':
                case 'Plowing & Snow Clearing':
                case 'Manpower':
                case 'Other':
                    renewalDate.setFullYear(renewalDate.getFullYear() + 1);
                    break;
                default:
                    expiryDate.value = '';
                    return;
            }
            expiryDate.value = renewalDate.toISOString().slice(0, 10);
        });
        document.getElementById('resourceForm')?.addEventListener('submit', event => {
            if (!latInput?.value || !lngInput?.value) {
                event.preventDefault();
                document.getElementById('posError').textContent =
                    'Posisjon på kartet må velges.';
            }
        });
        window.resqRegistration.bindCurrentLocationButton('useCurrentLocation', {
            onPosition: (latitude, longitude) => {
                setPosition(latitude, longitude);
                map.setView([latitude, longitude], 13);
            }
        });
        const modalElement = document.getElementById('registrationModal');
        if (modalElement.dataset.openRegistrationModal === 'true') {
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }
    </script>
}
