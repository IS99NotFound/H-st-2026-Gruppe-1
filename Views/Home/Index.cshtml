@model H_st_2026_Gruppe_1.Models.ResourceEntry
@{
    ViewData["Title"] = "Home Page";
    ViewData["FullWidth"] = true;
}
<div class="main-layout">

    <aside id="side-panel" class="side-panel" aria-label="Resource registration">
        <div class="side-panel-header">
            <div>
                <h1>Register a resource</h1>
            </div>
            <button class="panel-toggle panel-close" type="button" aria-controls="side-panel" aria-expanded="false">
                <span class="visually-hidden">Close resource panel</span>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        <!-- Form for registering a resource -->
        <form id="resourceForm" asp-controller="Home" asp-action="RegisterResource" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-2">
                <label for="nameInput">Full name</label>
                <input type="text" name="Name" id="nameInput" value="@Model.Name" class="form-control" required />
                <small id="nameError" class="text-danger"></small>
                <span asp-validation-for="Name" class="text-warning"></span> 
                <div asp-validation-summary="ModelOnly" class="text-danger"></div> 
            </div>

            <div class="mb-2">
                <label for="contactInput">Contact information</label>
                <input type="text" name="Phone" id="contactInput" value="@Model.Phone" class="form-control" placeholder="Phone number or email" required />
                <small id="contactError" class="text-danger"></small>
                <span asp-validation-for="Phone" class="text-warning"></span>
            </div>

            <div class="mb-2">
                <label for="resourceType">Resource type</label>
                <select name="CategoryId" id="resourceType" class="form-control" required>
                    <option value="">Select an option</option>
                    @foreach (var category in (List<Category>)ViewBag.Categories)
                    {
                        <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">@category.CategoryName</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" id="descriptionInput" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <div class="mb-2">
                <label asp-for="AvailableFrom">Effective date</label>
                <input type="date" asp-for="AvailableFrom" class="form-control" />
                <span asp-validation-for="AvailableFrom" class="text-danger"></span>
            </div>
            
            <div class="mb-2">
                <label asp-for="ExpirationDate">Expiration date</label>
                <input type="date" asp-for="ExpirationDate" id="expiryDate" class="form-control" />
                <span asp-validation-for="ExpirationDate" class="text-danger"></span>

            </div>

            <!-- Filled by JavaScript when the user clicks the map -->
            <input type="hidden" asp-for="Latitude" id="latInput"/>
            <input type="hidden" asp-for="Longitude" id="lngInput"/>
            <p id="posText" class="placeholder-text">
                @(Model.Latitude != null && Model.Longitude != null
                    ? $"Selected position: lat:{Model.Latitude:F5}, lng: {Model.Longitude:F5}"
                    : "No position marked on the map")
            </p>
            <span asp-validation-for="Latitude" class="text-danger d-block mb-2" id="posError"></span>

            <button type="submit" class="btn btn-primary">Register resource</button>
        </form>
    </aside>

    <!-- Map area (2/3) -->
    <section class="map-area">
        <div id="map" role="application" aria-label="Interactive map"></div>
        <p id="map-status" class="map-status" role="status" aria-live="polite">Loading map ...</p>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
    <script>
        const map = L.map('map').setView([58.4614, 8.7683], 13);
        window.resqMap = map;

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

        const mapStatus = document.getElementById('map-status');
        mapStatus.textContent = 'The map is ready. Select a position or use your current location.';

        let selectedMarker = null;

        // Check if position already exists (E.g. when editing)
        const initialLat = parseFloat(document.getElementById('latInput').value);
        const initialLng = parseFloat(document.getElementById('lngInput').value);
        if (!isNaN(initialLat) && !isNaN(initialLng)) {
        map.setView([initialLat, initialLng], 13);
        selectedMarker = L.marker([initialLat, initialLng]).addTo(map)
        .bindPopup('Selected position: ' + initialLat.toFixed(5) + ', ' + initialLng.toFixed(5))
        .openPopup();
    } else if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function (position) {
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;
            map.setView([lat, lng], 13);
            L.marker([lat, lng]).addTo(map).bindPopup('You are here').openPopup();
            mapStatus.textContent = 'The map is showing your current location.';
        }, function (error) {
            console.log('Could not get position:', error.message);
            mapStatus.textContent = 'Your location could not be found. You can still select a position on the map.';
        });
    }

        const resourceType = document.getElementById('resourceType');
        const expiryDate = document.getElementById('expiryDate');
        const resourceForm = document.getElementById('resourceForm');
        const nameInput = document.getElementById('nameInput');
        const contactInput = document.getElementById('contactInput');
        const nameError = document.getElementById('nameError');
        const contactError = document.getElementById('contactError');

        // Validate form after submitting
        resourceForm.addEventListener('submit', function (e) {
        let hasErrors = false;

        if (nameInput && !nameInput.value.trim()) {
        if (nameError) {
        nameError.textContent = 'Name is required.';
        nameError.hidden = false;
    }
        hasErrors = true;
    }

        if (contactInput && !contactInput.value.trim()) {
        if (contactError) {
        contactError.textContent = 'A phone number or email address is required.';
        contactError.hidden = false;
    }
        hasErrors = true;
    }

        const lat = document.getElementById('latInput').value;
        const posError = document.getElementById('posError');
        if (!lat) {
        if (posError) {
        posError.textContent = 'Position on the map must be filled out';
    }
        hasErrors = true;
    }

        // If error, cancel report
        if (hasErrors) {
        e.preventDefault();
    }
    });

        // Hide error messages while user types 
        if (nameInput) {
        nameInput.addEventListener('input', function () {
            if (nameError) nameError.hidden = nameInput.value.trim() !== '';
        });
    }

        if (contactInput) {
        contactInput.addEventListener('input', function () {
            if (contactError) contactError.hidden = contactInput.value.trim() !== '';
        });
    }

        // Calculate expiration date when resource type changes 
        if (resourceType) {
        resourceType.addEventListener('change', function () {
            const renewalDate = new Date();
            switch (resourceType.value) {
                case 'Food':
                    renewalDate.setDate(renewalDate.getDate() + 14);
                    break;
                case 'Medical':
                    renewalDate.setMonth(renewalDate.getMonth() + 1);
                    break;
                case 'Materials':
                    renewalDate.setMonth(renewalDate.getMonth() + 6);
                    break;
                case 'Shelter':
                case 'Transport':
                case 'Other':
                    renewalDate.setFullYear(renewalDate.getFullYear() + 1);
                    break;
                default:
                    expiryDate.value = '';
                    return;
            }

            const year = renewalDate.getFullYear();
            const month = String(renewalDate.getMonth() + 1).padStart(2, '0');
            const day = String(renewalDate.getDate()).padStart(2, '0');
            expiryDate.value = `${year}-${month}-${day}`;
        });
    }

    // A to B line
    let abMode = null;
    let markerA = null;
    let markerB = null;
    let abLine = null;
    let abButton = null;

    function createAbIcon(letter) {
        return L.divIcon({
            className: '',
            html: '<div class="ab-marker"><span>' + letter + '</span></div>',
            iconSize: [28, 28],
            iconAnchor: [13, 34]
        });
    }

    function resetAb() {
        if (markerA) map.removeLayer(markerA);
        if (markerB) map.removeLayer(markerB);
        if (abLine) map.removeLayer(abLine);
        markerA = markerB = abLine = null;
    }

    function setAbMode(mode) {
        abMode = mode;
        const active = mode !== null;
    

    map.getContainer().classList.toggle('placing', active);
        abButton.classList.toggle('active', active);
    }

    function showBothPoints() {
        const bounds = abLine.getBounds();
        if (!map.getBounds().pad(-0.1).contains(bounds))
        {
            map.fitBounds(bounds, { padding: [60, 60] });
        }
    }

    const AbControl = L.Control.extend({
        options: { position: 'topleft' },

        onAdd: function () {
            const container = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
            abButton = L.DomUtil.create('a', 'ab-button', container);
            abButton.href = '#';
            abButton.title = 'Mark point A and B'
            abButton.setAttribute('role', 'button');
            abButton.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-line">
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M4 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
        <path d="M16 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
        <path d="M7.5 16.5l9 -9" />
    </svg>`;

            L.DomEvent.disableClickPropagation(container);
            L.DomEvent.on(abButton, 'click', function (e) {
                L.DomEvent.preventDefault(e);
                if (abMode) {
                    setAbMode(null);
                } else {
                    resetAb();
                    setAbMode('A');
                }
            });

            return container;
        }
    });

    new AbControl().addTo(map);

        // Click on the map to choose a position
        map.on('click', function (e) {
            if (abMode == 'A') {
                markerA = L.marker(e.latlng, { icon: createAbIcon('A') }).addTo(map);
                setAbMode('B');
                return;
            }

            if (abMode == 'B') {
                markerB = L.marker(e.latlng, { icon: createAbIcon('B') }).addTo(map);
                abLine = L.polyline([markerA.getLatLng(), markerB.getLatLng()], {
                    color: '#ff8c00',
                    weight: 4,
                    dashArray: '8 6'
                }).addTo(map);
                showBothPoints();
                setAbMode(null);
                return;
            }

        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        if (selectedMarker) {
        map.removeLayer(selectedMarker);
    }

        selectedMarker = L.marker([lat, lng]).addTo(map)
        .bindPopup('Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5))
        .openPopup();

        document.getElementById('latInput').value = lat;
        document.getElementById('lngInput').value = lng;
        document.getElementById('posText').innerText = 'Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5);

        const posError = document.getElementById('posError');
        if (posError) {
        posError.textContent = '';
    }
    });

        // Open sidepanel automatically when editing
        const resourceId = parseInt(document.getElementById('Id')?.value || '0');
        const sidePanel = document.getElementById('side-panel');

        if (resourceId > 0 && sidePanel) {
        sidePanel.classList.add('open');
    }
</script>
