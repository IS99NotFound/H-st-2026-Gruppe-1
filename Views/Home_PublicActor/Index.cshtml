

<!-- Kartområdet (2/3 av bredden) -->
<div>
    <section class="map-area">
        <div id="map" role="application" aria-label="Interactive map"></div>
        <p id="map-status" class="map-status" role="status" aria-live="polite">Loading map ...</p>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>

    // Oppretter kartet og starter i Grimstad
    const map = L.map('map').setView([58.4614, 8.7683], 13);
    // Mobilpanelet bruker denne referansen når kartets synlige størrelse endres
    window.resqMap = map;

    // Legger på kartfliser fra OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    const mapStatus = document.getElementById('map-status');
    mapStatus.textContent = 'The map is ready. Select a position or use your current location.';

    // Prøver å finne brukerens posisjon og flytte kartet dit
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function (position) {
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;

            map.setView([lat, lng], 13);
            L.marker([lat, lng]).addTo(map).bindPopup('You are here').openPopup();
            mapStatus.textContent = 'The map is showing your current location.';
        }, function (error) {
            console.log('Could not get position:', error.message);
            mapStatus.textContent = 'Your location could not be found. You can still select a position on the map.';
        });
    } else {
        console.log('This browser does not support geolocation');
        mapStatus.textContent = 'This browser does not support geolocation. Select a position on the map.';
    }

    // Henter elementene i skjemaet som JavaScript trenger
    const resourceType = document.getElementById('resourceType');
    const expiryDate = document.getElementById('expiryDate');
    const resourceForm = document.getElementById('resourceForm');
    const nameInput = document.getElementById('nameInput');
    const nameError = document.getElementById('nameError');
    const resourceTypeError = document.getElementById('resourceTypeError');
    const contactInput = document.getElementById('contactInput');
    const contactError = document.getElementById('contactError');

    // Viser en enkel feilmelding og stopper innsendingen hvis et påkrevd felt er tomt
    resourceForm.addEventListener('submit', function (event) {
        let hasErrors = false;

        if (!nameInput.value.trim()) {
            nameError.textContent = 'Name is required.';
            nameError.hidden = false;
            hasErrors = true;
        }

        if (!contactInput.value.trim()) {
            contactError.textContent = 'A phone number or email address is required.';
            contactError.hidden = false;
            hasErrors = true;
        }

        if (!resourceType.value) {
            resourceTypeError.textContent = 'Select a resource type.';
            resourceTypeError.hidden = false;
            hasErrors = true;
        }

        if (hasErrors) {
            event.preventDefault();
        }
    });

    // Skjuler feilmeldingen når brukeren begynner å skrive
    nameInput.addEventListener('input', function () {
        nameError.hidden = nameInput.value.trim() === '';
    });

    contactInput.addEventListener('input', function () {
        contactError.hidden = contactInput.value.trim() === '';
    });

    // Viser utløpsdatoen når brukeren velger en ressurstype
    resourceType.addEventListener('change', function () {
        resourceTypeError.hidden = resourceType.value === '';
        const renewalDate = new Date();

        switch (resourceType.value) {
            case 'Mat':
                renewalDate.setDate(renewalDate.getDate() + 14);
                break;
            case 'Medisinsk':
                renewalDate.setMonth(renewalDate.getMonth() + 1);
                break;
            case 'Materialer':
                renewalDate.setMonth(renewalDate.getMonth() + 6);
                break;
            case 'Shelter':
            case 'Transport':
            case 'Annet':
                renewalDate.setFullYear(renewalDate.getFullYear() + 1);
                break;
            default:
                expiryDate.value = '';
                return;
        }

        // Gjør om datoen til formatet åååå-mm-dd
        const year = renewalDate.getFullYear();
        const month = String(renewalDate.getMonth() + 1).padStart(2, '0');
        const day = String(renewalDate.getDate()).padStart(2, '0');
        expiryDate.value = `${year}-${month}-${day}`;
    });

    // Husker markøren brukeren har valgt, slik at den kan fjernes ved nytt klikk
    let selectedMarker = null;

    // Stopper innsendingen hvis brukeren ikke har valgt en posisjon i kartet
    document.querySelector('form').addEventListener('submit', function (e) {
        const lat = document.getElementById('latInput').value;
        const posError = document.getElementById('posError');

        if (!lat) {
            e.preventDefault(); // Stopper innsendingen av skjemaet
            if (posError) {
                posError.textContent = 'Du må velge en posisjon på kartet før du kan registrere.';
            }
        }
    });

    // Fjerner eventuell feilmelding når brukeren klikker på kartet
    map.on('click', function (e) {
        const posError = document.getElementById('posError');
        if (posError) {
            posError.textContent = '';
        }
    });

    // Et klikk i kartet plasserer markøren og fyller koordinatene inn i skjemaet
    map.on('click', function (e) {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        if (selectedMarker) {
            map.removeLayer(selectedMarker);
        }

        selectedMarker = L.marker([lat, lng]).addTo(map)
            .bindPopup('Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5))
            .openPopup();

        document.getElementById('latInput').value = lat;
        document.getElementById('lngInput').value = lng;
        document.getElementById('posText').innerText = 'Selected position: ' + lat.toFixed(5) + ', ' + lng.toFixed(5);
    });
</script>