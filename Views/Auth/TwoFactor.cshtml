@model H_st_2026_Gruppe_1.Models.TwoFactorViewModel
@{
    ViewData["Title"] = "Verify sign-in";
}

<div class="auth-page">
    <section class="auth-brand-panel" aria-label="ResQ">
        <a class="auth-brand-name" asp-controller="Home" asp-action="Index">ResQ</a>
        <div class="auth-brand-message">
            <span class="auth-accent-line" aria-hidden="true"></span>
            <h1>Connecting<br />resources.</h1>
        </div>
        <i class="bi bi-shield-check auth-brand-icon" aria-hidden="true"></i>
    </section>

    <section class="auth-content">
        <div class="auth-form-container">
            <p class="auth-step-label">STEP 2 OF 2</p>
            <div class="auth-shield"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
            <h2>Verify it's you</h2>
            <p class="auth-description">Enter the six-digit code to continue to ResQ.</p>

            @if (!string.IsNullOrEmpty(Model.DemoCode))
            {
                <aside id="demo-code-dialog" class="auth-code-dialog" aria-labelledby="demo-code-title">
                    <div class="auth-code-dialog-header">
                        <span class="auth-code-dialog-icon"><i class="bi bi-chat-square-text" aria-hidden="true"></i></span>
                        <div>
                            <p class="auth-code-dialog-eyebrow">ResQ verification</p>
                            <h3 id="demo-code-title">Your sign-in code</h3>
                        </div>
                    </div>
                    <p class="auth-code-dialog-message">Use this code to finish signing in.</p>
                    <div class="auth-code-dialog-code" aria-label="Your sign-in code">@Model.DemoCode</div>
                    <button type="button" class="btn auth-code-copy" data-copy-code="@Model.DemoCode">
                        <i class="bi bi-copy" aria-hidden="true"></i>
                        <span>Copy code</span>
                    </button>
                    <span class="auth-code-copy-status" role="status" aria-live="polite"></span>
                </aside>
            }

            <form asp-controller="Auth" asp-action="VerifyTwoFactor" method="post" data-code-form>
                <input asp-for="PendingId" type="hidden" />

                <div class="auth-field">
                    <label asp-for="Code">Six-digit code</label>
                    <div class="auth-code-inputs" data-code-inputs>
                        @for (var index = 0; index < 6; index++)
                        {
                            <input class="auth-code-input" type="text" inputmode="numeric" maxlength="1"
                                   autocomplete="@(index == 0 ? "one-time-code" : "off")"
                                   aria-label="Digit @(index + 1)" />
                        }
                    </div>
                    <input asp-for="Code" type="hidden" data-code-value />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <button type="submit" class="btn auth-submit">Verify code</button>
            </form>
            <a class="auth-back-link" asp-controller="Auth" asp-action="Login">Back to sign in</a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}